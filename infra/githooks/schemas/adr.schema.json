{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["id", "fecha", "titulo", "estado", "contexto", "decision", "consecuencias", "alternativas", "actores"],
  "properties": {
    "id": { "type": "string", "pattern": "^ADR-\\d{3}$" },
    "fecha": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "titulo": { "type": "string" },
    "estado": { "type": "string", "enum": ["aceptada", "propuesta", "rechazada", "supersedida"] },
    "contexto": { "type": "string" },
    "decision": { "type": "string" },
    "consecuencias": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "alternativas": {
      "type": "array",
      "items": { "type": "string" }
    },
    "actores": {
      "type": "array",
      "items": { "type": "string", "pattern": "^@" }
    }
  }
}
