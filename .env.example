# ============================================================
# .env.example — Variables de entorno requeridas
# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.
# ============================================================

NODE_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=5173
SCALE_MODE=local

# ─── URLS ──────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ─── BASE DE DATOS (core_db) ────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5444/core_db
TEST_DATABASE_URL=postgresql://user:password@localhost:5444/db_test
VECTOR_DIMENSION=384

# ─── BASE DE DATOS (community_db) ───────────────────────────
COMMUNITY_DATABASE_URL=postgresql://user:password@localhost:5435/community_db

# ─── REDIS ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── RABBITMQ ───────────────────────────────────────────────
RABBITMQ_URL=amqp://user:password@localhost:5672/

# ─── JWT ──────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ─── GOOGLE OAUTH (login de usuarios) ────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ─── MAILJET ──────────────────────────────────────────────────
# https://app.mailjet.com/account/api_keys
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret
MAILJET_FROM_EMAIL=no-reply@example.com
MAILJET_FROM_NAME="Soporte"
MAILJET_SUPPORT_EMAIL=contacto@example.com

# ─── CLOUDINARY ──────────────────────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ROOT_FOLDER=veterinaria.v2

# ─── MERCADO PAGO — suscripciones de la plataforma ──────────
# Crear app nueva en https://www.mercadopago.com.ar/developers/panel
MP_PLATFORM_ENV=sandbox
MP_PLATFORM_ACCESS_TOKEN=your-mp-access-token
MP_PLATFORM_PUBLIC_KEY=your-mp-public-key
MP_PLATFORM_WEBHOOK_SECRET=your-webhook-secret
MP_PLATFORM_SUCCESS_URL=http://localhost:5173/configuracion/subscripcion?status=success
MP_PLATFORM_FAILURE_URL=http://localhost:5173/configuracion/subscripcion?status=failure
MP_PLATFORM_PENDING_URL=http://localhost:5173/configuracion/subscripcion?status=pending

# ─── MERCADO PAGO — OAuth por tenant (cobros propios) ───────
MP_OAUTH_APP_ID=your-mp-app-id
MP_OAUTH_CLIENT_SECRET=your-mp-oauth-client-secret
MP_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/mercadopago/oauth/callback
MP_OAUTH_WEBHOOK_URL=http://localhost:8000/api/v1/webhooks/mp/tenant

# ─── BACKBLAZE B2 (backups) ───────────────────────────────────
# https://www.backblaze.com/ → Buckets → Create a Bucket (Private) → Application Keys
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# ─── AFIP / FACTURACIÓN ELECTRÓNICA ──────────────────────────
AFIPSDK_ACCESS_TOKEN=your-afip-token

# ─── CLOUDFLARE TUNNEL ─────────────────────────────────────────
CLOUDFLARE_TUNNEL_ID=your-tunnel-id
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
DEV_TUNNEL_URL=https://your-tunnel.trycloudflare.com

# ─── IA — APIs (al menos una requerida) ───────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_DEFAULT=llama-3.1-8b-instant

# Embeddings: fastembed (ONNX, local, sin API, ~90MB vs ~2GB de torch)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── ENCRIPTACIÓN ────────────────────────────────────────────
# Generar con: openssl rand -hex 32
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-key
ENCRYPTION_IV=change-me-to-a-16-byte-hex-iv

# ─── ADMIN (subsistema oculto) ──────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me
ADMIN_ROUTE_PATH=/access_role/admin/developer

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── OTROS ──────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=20
LOG_LEVEL=DEBUG
TRIAL_PERIOD_DAYS=3
DISABLE_WORKERS=0

# ─── PLANES (en ARS) ──────────────────────────────────────────
PLAN_MENSUAL_PRECIO=35000
PLAN_SEMESTRAL_PRECIO=180000
PLAN_ANUAL_PRECIO=420000
